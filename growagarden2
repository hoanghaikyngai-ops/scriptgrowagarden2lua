local function findRemote(...)
    local names = {...}
    for _, name in ipairs(names) do
        if not name then continue end
        local r = ReplicatedStorage:FindFirstChild(name)
        if r then return r end
        local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
        if remotesFolder then
            r = remotesFolder:FindFirstChild(name)
            if r then return r end
        end
        local eventsFolder = ReplicatedStorage:FindFirstChild("Events") or ReplicatedStorage:FindFirstChild("RemoteEvents")
        if eventsFolder then
            r = eventsFolder:FindFirstChild(name)
            if r then return r end
        end
    end
    return nil
end

local function safeFire(remote, ...)
    if not remote then return false end
    local ok, err = pcall(function() remote:FireServer(...) end)
    if not ok then
        if typeof(remote) == "Instance" and remote:IsA("RemoteFunction") then
            pcall(function() remote:InvokeServer(...) end)
        end
    end
    return true
end

local function doAutoBuySeed()
    if not getgenv().Config or not getgenv().Config["Buy Seed"] or not getgenv().Config["Buy Seed"]["Enable"] then return end
    local buyRemote = findRemote("BuyItem", "BuySeed", "Buy")
    if not buyRemote then return end
    local seeds = getgenv().Config["Buy Seed"]["Seed"] or {}
    for _, seed in ipairs(seeds) do
        if not getgenv().Config["Buy Seed"]["Enable"] then break end
        if type(seed) == "string" then
            pcall(function() safeFire(buyRemote, seed, 1) end)
            task.wait(0.1)
        end
    end
end

local function doAutoPlant()
    if not getgenv().Config or not getgenv().Config["Plant Seed"] or not getgenv().Config["Plant Seed"]["Enable"] then return end
    if not LocalPlayer or not LocalPlayer.Name then LocalPlayer = Players.LocalPlayer end
    local plantRemote = findRemote("PlantSeed", "Plant")
    if not plantRemote then return end

    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return end
    local myPlot = plotsFolder:FindFirstChild(LocalPlayer.Name)
    if not myPlot then return end

    local seeds = getgenv().Config["Plant Seed"]["Seed"] or {}
    local chosenSeed = seeds[1] -- Mặc định lấy hạt đầu danh sách cấu hình
    if type(chosenSeed) ~= "string" then return end

    for _, zone in ipairs(myPlot:GetChildren()) do
        if not getgenv().Config["Plant Seed"]["Enable"] then break end
        if typeof(zone) ~= "Instance" then continue end
        if #zone:GetChildren() == 0 then
            pcall(function()
                safeFire(plantRemote, chosenSeed, zone)
            end)
            task.wait(0.2)
        end
    end
end

local isRunning = false
local farmLoop

local function startAutoFarm()
    if isRunning then
        Rayfield:Notify({Name = "Thông báo", Content = "Hệ thống Auto Farm đang hoạt động ngầm!", Duration = 3})
        return
    end
    isRunning = true
    Rayfield:Notify({Name = "Thành công", Content = "Đã kích hoạt vòng lặp Auto Farm!", Duration = 3})
    farmLoop = task.spawn(function()
        while isRunning do
            pcall(function()
                doAutoBuySeed()
                doAutoPlant()
            end)
            task.wait(1)
        end
    end)
end

local function stopAutoFarm()
    isRunning = false
    Rayfield:Notify({Name = "Thông báo", Content = "Đã tắt hoàn toàn các tác vụ Auto Farm.", Duration = 3})
end

